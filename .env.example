# Required
OPENAI_API_KEY=
SERPER_API_KEY=

# Optional: push notifications through Pushover. Without them, the notification tool
# reports a failure to the agent and the rest of the app carries on.
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Login for the web UI. Required on Hugging Face Spaces, optional everywhere else.
SIDEKICK_USERNAME=
SIDEKICK_PASSWORD=
